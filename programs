int main(){
    int n,i,j,k;
    int graph[10][10];

    printf("Enter the Number of Vertices :");
    scanf("%d",&n);

    printf("\nEnter the Adjacency matrix \n");
    for (i=0;i<n;i++){
        for(j=0;j<n;j++){
            scanf("%d",&graph[i][j]);
        }
    }

    for(k=0;k<n;k++){
        for(i=0;i<n;i++){
            for(j=0;j<n;j++){
                if (graph[i][k]!=INF && graph[k][j]!= INF && graph[i][k]+graph[k][j]<graph[i][j]){
                    graph[i][j]=graph[i][k]+graph[k][j];
                }
            }
        }
    }

    printf("\n =======Final Adjacency Matrix=======\n");

    printf("      ");
    for(i=0;i<n;i++){
        printf("V%-6d",i+1);
    }
    printf("\n");

    for(i=0;i<n;i++){
        printf("V%-5d",i+1);
        for(j=0;j<n;j++){
            if(graph[i][j]==INF){
                printf("INF   ");
            }else{
                printf("%-6d",graph[i][j]);
            }
        }
        printf("\n");
    }
    return 0;
}



