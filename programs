#include <stdio.h>
#include <stdlib.h>

int x[32],n;
int place(int k, int i){
    int j;
    for (j=1;j<k;j++){
        if ( x[j]==i || abs(x[j]-i)==abs(j-k)){
            return 0;
        }
    }
    return 1;
}

void Nqueen (int k, int n){
    int i;
    for(i=1;i<=n;i++){
        if(place(k,i)){
            x[k]=i;
            if(k==n){
                for(i=1;i<=n;i++){
                    printf("%d",x[i]);
                }
                printf("\n");
            }else{
                Nqueen(k+1,n);
            }
        }
    }
}

int main(){
    printf("Enter the Value of N :");
    scanf("%d",&n);

    printf("\n Solution :\n");

    Nqueen(1,n);
}


