        scanf("%f",&wt[i]);
    }

    printf("Enter the Size of bucket : ");
    scanf("%f",&w);

    for (i=0;i<n;i++){
        ratio[i]=p[i]/wt[i];
        x[i]=0;
    }

    for (i=0;i<n-1;i++){
        for(j=i+1;j<n;j++){
         if (ratio[i]<ratio[j]){
             temp=ratio[i];
             ratio[i]=ratio[j];
             ratio[j]=temp;

             temp=wt[i];
             wt[i]=wt[j];
             wt[j]=temp;

             temp=p[i];
             p[i]=p[j];
             p[j]=temp;
         }   
        }
    }

    for(i=0;i<n;i++){
        if(weight+wt[i]<w){
            x[i]=1;
            weight=weight+wt[i];
            profit=profit+p[i];
        }else{
            x[i]=(w-weight)/wt[i];
            weight=weight+x[i]*wt[i];
